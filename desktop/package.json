{
  "name": "codepilot-desktop",
  "productName": "codePilot",
  "version": "0.1.0",
  "description": "Desktop control plane for local coding agents",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit",
