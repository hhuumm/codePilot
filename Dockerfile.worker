FROM node:22-bookworm-slim

ARG AGENT=codex
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && if [ "$AGENT" = "codex" ]; then npm install -g @openai/codex; \
       elif [ "$AGENT" = "claude" ]; then npm install -g @anthropic-ai/claude-code; \
       else echo "Unsupported AGENT=$AGENT" >&2; exit 1; fi \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 worker
COPY package.json package-lock.json tsconfig.json ./
COPY src ./src
RUN npm ci && npm run build && npm prune --omit=dev
USER worker
WORKDIR /workspace

ENTRYPOINT ["node", "/dist/src/worker.js"]
